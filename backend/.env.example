DB_PATH=./cantea.db
PUBLIC_BASE_URL=http://localhost:8000
# Separate comma-separated frontend origins. Native apps do not need CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8081,http://localhost:19006

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Displayed on the public privacy/deletion pages. Set before deployment.
SUPPORT_EMAIL=replace-me@example.com

# Hosted storage: paste your private PostgreSQL connection URL here locally,
# or set DATABASE_URL in Render Environment. Never commit a real URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# When DATABASE_URL is set, DB_PATH is ignored and connection errors fail closed.
